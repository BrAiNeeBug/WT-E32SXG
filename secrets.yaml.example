# Copy this file to "secrets.yaml" (same folder as your ESPHome config)
# and fill in your own values. secrets.yaml should NEVER be committed/pushed —
# add it to your .gitignore.

# --- WiFi / network ---
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"
ap_password: "FallbackAPPassword123"

# --- ESPHome API / OTA ---
api_key: "base64:GENERATE_WITH_ESPHOME_OR_openssl_rand_-base64_32"
ota_password: "YourOTAPassword"

# --- wM-Bus meters ---
# meter_id: the meter's serial/ID (usually printed on the meter or found via telegram sniffing)
# key: the meter's AES decryption key (from the manufacturer / installer documentation)
meter1_id: "0xXXXXXXXX"
meter1_key: "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

meter2_id: "0xXXXXXXXX"
meter2_key: "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
